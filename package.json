{
  "name": "vscode_doc",
  "version": "1.0.0",
  "description": "MkDocs Electron Viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
